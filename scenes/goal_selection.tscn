[gd_scene load_steps=2 format=3 uid="uid://c_goal_selection"]

[ext_resource type="Script" path="res://scripts/goal_selection.gd" id="1_goalsel"]

[node name="GoalSelectionCanvas" type="CanvasLayer"]
layer = 100
script = ExtResource("1_goalsel")

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.6)

[node name="Panel" type="Panel" parent="Backdrop"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -350.0
offset_top = -240.0
offset_right = 350.0
offset_bottom = 240.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBoxContainer" type="VBoxContainer" parent="Backdrop/Panel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_top = 20.0
offset_right = -24.0
offset_bottom = -20.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 12

[node name="TitleLabel" type="Label" parent="Backdrop/Panel/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Piliin ang Iyong 1-Year Life Goal!"
horizontal_alignment = 1

[node name="SubtitleLabel" type="RichTextLabel" parent="Backdrop/Panel/VBoxContainer"]
custom_minimum_size = Vector2(0, 75)
layout_mode = 2
bbcode_enabled = true
text = "Goal details here"
fit_content = true

[node name="GoalProgressBar" type="ProgressBar" parent="Backdrop/Panel/VBoxContainer"]
visible = false
custom_minimum_size = Vector2(0, 28)
layout_mode = 2
max_value = 40000.0

[node name="OptionsContainer" type="VBoxContainer" parent="Backdrop/Panel/VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 10
alignment = 1

[node name="SavingsControls" type="VBoxContainer" parent="Backdrop/Panel/VBoxContainer"]
visible = false
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 10
alignment = 1

[node name="QuickDepositRow" type="HBoxContainer" parent="Backdrop/Panel/VBoxContainer/SavingsControls"]
layout_mode = 2
theme_override_constants/separation = 10
alignment = 1

[node name="Dep500" type="Button" parent="Backdrop/Panel/VBoxContainer/SavingsControls/QuickDepositRow"]
layout_mode = 2
