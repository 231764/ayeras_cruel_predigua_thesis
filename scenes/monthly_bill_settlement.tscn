[gd_scene load_steps=2 format=3 uid="uid://c_monthly_bill_settlement"]

[ext_resource type="Script" path="res://scripts/monthly_bill_settlement.gd" id="1_mbs"]

[node name="MonthlyBillSettlementCanvas" type="CanvasLayer"]
layer = 100
script = ExtResource("1_mbs")

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.65)

[node name="Panel" type="Panel" parent="Backdrop"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -360.0
offset_top = -240.0
offset_right = 360.0
offset_bottom = 240.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBoxContainer" type="VBoxContainer" parent="Backdrop/Panel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_top = 20.0
offset_right = -24.0
offset_bottom = -20.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 14

[node name="TitleLabel" type="Label" parent="Backdrop/Panel/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Katapusan ng Buwan — Manual Bill Settlement"
horizontal_alignment = 1

[node name="DetailsLabel" type="RichTextLabel" parent="Backdrop/Panel/VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
text = "Bill details..."

[node name="ButtonsContainer" type="VBoxContainer" parent="Backdrop/Panel/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="PayCashButton" type="Button" parent="Backdrop/Panel/VBoxContainer/ButtonsContainer"]
custom_minimum_size = Vector2(0, 42)
layout_mode = 2
text = "1. Bayaran gamit ang Available Cash"

[node name="PaySavingsButton" type="Button" parent="Backdrop/Panel/VBoxContainer/ButtonsContainer"]
custom_minimum_size = Vector2(0, 42)
layout_mode = 2
text = "2. Gamitin ang Cash + Hugutin sa Ipon/Savings"

[node name="IncurDebtButton" type="Button" parent="Backdrop/Panel/VBoxContainer/ButtonsContainer"]
custom_minimum_size = Vector2(0, 42)
layout_mode = 2
text = "3. Ilista ang Kulang bilang Utang"

[connection signal="pressed" from="Backdrop/Panel/VBoxContainer/ButtonsContainer/PayCashButton" to="." method="_on_pay_cash_pressed"]
[connection signal="pressed" from="Backdrop/Panel/VBoxContainer/ButtonsContainer/PaySavingsButton" to="." method="_on_pay_savings_pressed"]
[connection signal="pressed" from="Backdrop/Panel/VBoxContainer/ButtonsContainer/IncurDebtButton" to="." method="_on_incur_debt_pressed"]
