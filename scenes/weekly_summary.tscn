[connection signal="pressed" from="Panel/VBoxContainer/ActionRow/BudgetPlanButton" to="." method="_on_budget_plan_pressed"]
[connection signal="pressed" from="Panel/VBoxContainer/ActionRow/PlannerPlanButton" to="." method="_on_planner_plan_pressed"]
[connection signal="pressed" from="Panel/VBoxContainer/ContinueButton" to="." method="_on_continue_pressed"]
