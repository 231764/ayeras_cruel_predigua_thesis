[gd_scene load_steps=2 format=3 uid="uid://c_weekly_summary"]

[ext_resource type="Script" path="res://scripts/weekly_summary.gd" id="1_wkly"]

[node name="WeeklySummaryCanvas" type="CanvasLayer"]
layer = 100
script = ExtResource("1_wkly")

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.55)

[node name="Panel" type="Panel" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -310.0
offset_top = -235.0
offset_right = 310.0
offset_bottom = 235.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBoxContainer" type="VBoxContainer" parent="Panel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 22.0
offset_top = 18.0
offset_right = -22.0
offset_bottom = -18.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 10
alignment = 1

[node name="Title" type="Label" parent="Panel/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Katapusan ng Week"
horizontal_alignment = 1

[node name="IncomeLabel" type="Label" parent="Panel/VBoxContainer"]
layout_mode = 2
text = "Pumasok na Pera: + PHP 0"
horizontal_alignment = 1

[node name="ExpensesLabel" type="Label" parent="Panel/VBoxContainer"]
layout_mode = 2
text = "Mga Nagastos: - PHP 0"
horizontal_alignment = 1

[node name="NetLabel" type="Label" parent="Panel/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Natira sa Pera: PHP 0"
horizontal_alignment = 1

[node name="HSeparator" type="HSeparator" parent="Panel/VBoxContainer"]
layout_mode = 2

[node name="DetailsRTF" type="RichTextLabel" parent="Panel/VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
text = "Weekly savings, debt, and stat deltas..."

[node name="HSeparator2" type="HSeparator" parent="Panel/VBoxContainer"]
layout_mode = 2

[node name="ActionRow" type="HBoxContainer" parent="Panel/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 10
alignment = 1

[node name="BudgetPlanButton" type="Button" parent="Panel/VBoxContainer/ActionRow"]
custom_minimum_size = Vector2(0, 38)
layout_mode = 2
size_flags_horizontal = 3
